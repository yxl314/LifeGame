# Doxygen configuration for the LifeGame layered MVC project.
PROJECT_NAME           = "LifeGame"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Conway's Game of Life - standard layered MVC reference"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
INPUT                  = src README.md docs/architecture.md docs/performance.md docs/rendering-profile.md
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = build docs/doxygen
EXCLUDE_PATTERNS       = */tests/* */build/*
USE_MDFILE_AS_MAINPAGE = README.md
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
ALPHABETICAL_INDEX     = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = NO
DISTRIBUTE_GROUP_DOC   = YES
SUBGROUPING            = YES
TYPEDEF_HIDES_STRUCT   = NO
LOOKUP_CACHE_SIZE      = 0
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src
INCLUDE_FILE_PATTERNS  =
PREDEFINED             = Q_OBJECT= Q_SIGNALS=public Q_SLOTS=public signals=public slots= QT_BEGIN_NAMESPACE= QT_END_NAMESPACE= Q_DECLARE_LOGGING_CATEGORY(x)=
SKIP_FUNCTION_MACROS   = YES
