/* ==========================================================================
   生命游戏 —— 深色主题
   仅负责外观，所有布局与逻辑都在 C++ 中。
   ========================================================================== */

QMainWindow,
QWidget#Central {
    background-color: #0d1117;
}

QWidget {
    color: #c9d1d9;
    font-size: 13px;
}

QWidget#SidePanel {
    background-color: #161b22;
    border: none;
}

QScrollArea#SideScroll {
    background-color: #161b22;
    border: none;
    border-left: 1px solid #30363d;
}

QScrollArea#SideScroll > QWidget > QWidget {
    background-color: #161b22;
}

QLabel#Title {
    color: #f0f6fc;
    font-size: 24px;
    font-weight: 700;
}

QLabel#Subtitle {
    color: #6e7681;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

QFrame#Card {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
}

QLabel#StatValue {
    color: #58a6ff;
    font-size: 18px;
    font-weight: 700;
}

QLabel#StatCaption {
    color: #6e7681;
    font-size: 10px;
}

QLabel#Muted {
    color: #8b949e;
    font-size: 11px;
}

QLabel#ValueLabel {
    color: #3fb950;
    font-size: 11px;
    font-weight: 600;
}

QLabel#Hint {
    color: #6e7681;
    font-size: 11px;
    line-height: 1.5;
}

/* ---- 按钮 ---- */

QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 12px;
    color: #c9d1d9;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background-color: #161b22;
}

QPushButton:disabled {
    color: #6e7681;
    background-color: #161b22;
    border-color: #21262d;
}

QPushButton#PrimaryButton {
    background-color: #238636;
    border: 1px solid #2ea043;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #2ea043;
    border-color: #3fb950;
}

QPushButton#PrimaryButton:pressed {
    background-color: #1a6f2c;
}

/* ---- 输入控件 ---- */

QComboBox,
QSpinBox {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
    selection-background-color: #238636;
}

QComboBox:hover,
QSpinBox:hover {
    border-color: #8b949e;
}

QComboBox:focus,
QSpinBox:focus {
    border-color: #58a6ff;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    selection-background-color: #238636;
    selection-color: #ffffff;
    outline: 0;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 16px;
    background-color: #21262d;
    border-left: 1px solid #30363d;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #30363d;
}

/* ---- 滑块 ---- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #30363d;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #2ea043;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background-color: #3fb950;
    border: 2px solid #0d1117;
}

QSlider::handle:horizontal:hover {
    background-color: #56d364;
}

/* ---- 分组框 ---- */

QGroupBox {
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 16px;
    padding: 10px 10px 10px 10px;
    font-weight: 600;
    color: #8b949e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #8b949e;
}

/* ---- 菜单 ---- */

QMenuBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #21262d;
}

QMenuBar::item:pressed {
    background-color: #30363d;
}

QMenu {
    background-color: #161b22;
    border: 1px solid #30363d;
    padding: 6px;
}

QMenu::item {
    padding: 6px 28px 6px 26px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #238636;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #6e7681;
}

QMenu::separator {
    height: 1px;
    background-color: #30363d;
    margin: 5px 8px;
}

/* ---- 工具栏 ---- */

QToolBar#MainToolBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
    spacing: 3px;
    padding: 3px 8px;
}

QToolBar::separator {
    width: 1px;
    background-color: #30363d;
    margin: 6px 5px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 8px;
    color: #c9d1d9;
}

QToolButton:hover {
    background-color: #21262d;
    border-color: #30363d;
}

QToolButton:pressed {
    background-color: #30363d;
}

QToolButton:checked {
    background-color: #238636;
    border-color: #2ea043;
    color: #ffffff;
}

QLabel#ToolbarBrand {
    color: #484f58;
    font-size: 10px;
    font-weight: 700;
    padding-right: 10px;
}

/* ---- 状态栏 ---- */

QStatusBar {
    background-color: #161b22;
    border-top: 1px solid #30363d;
    color: #8b949e;
    padding-left: 6px;
}

QStatusBar QLabel {
    color: #8b949e;
}

QLabel#StatusHint {
    color: #6e7681;
    font-size: 11px;
    padding-right: 8px;
}

/* ---- 其他 ---- */

QToolTip {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 5px 8px;
    border-radius: 4px;
}

QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
